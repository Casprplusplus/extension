{
  "name": "caspr-helper",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "build:public": "node scripts/build.js --public",
    "build:test": "node scripts/build.js --allow-http --test-backend",
    "dev": "node scripts/build.js --watch",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run check && npm run build:public"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.15"
  }
}
